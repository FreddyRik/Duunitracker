# Optional: Jina Reader API key for server-side Duunitori fetch fallback (local/dev)
# https://jina.ai/reader
JINA_API_KEY=

# Production: Cloudflare Worker URL for browser-side Duunitori HTML fetch
# Deploy workers/duunitori-proxy first, then set this to your *.workers.dev URL
# NEXT_PUBLIC_DUUNITORI_PROXY_URL=https://duunitracker-duunitori-proxy.<account>.workers.dev
